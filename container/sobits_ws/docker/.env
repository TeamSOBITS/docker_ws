# Docker Environment Configuration
# Set COMPUTE_TYPE to either "cpu" or "gpu"
COMPUTE_TYPE=cpu

# User Configuration
USER_NAME=sobits
WORKSPACE_NAME=sobits_ws

# System Configuration
UBUNTU_VERSION=22.04
INSTALL_ROS=false
ROS_DISTRO=humble

# GPU Configuration (only used when COMPUTE_TYPE=gpu)
CUDA_VERSION=12.9.1
